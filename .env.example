# DIGITAL FOSSIL Environment Configuration
PROJECT_NAME="Digital Fossil"
API_V1_STR="/api/v1"
SECRET_KEY="digital-fossil-insecure-dev-key-change-in-production-demo-only"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL="sqlite:///./digital_fossil.db"

# Engine Threshold Defaults
DEFAULT_SESSION_THRESHOLD_SECONDS=120
DEFAULT_MIN_RELATIONSHIP_SCORE=0.35
DEFAULT_ANOMALY_CONTAMINATION=0.10

# Optional LLM Explanation Layer (Works deterministically if empty)
# Set GEMINI_API_KEY or OPENAI_API_KEY to enable neural summary layer
LLM_API_KEY=""
LLM_PROVIDER="none"

# Safe Collector Monitored Directory (Must be an explicitly selected local test folder)
TEST_MONITOR_DIR="./data/test_folder"
